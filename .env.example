# MongoDB Connection URI (defaults to local or Atlas connection)
MONGODB_URI="mongodb://127.0.0.1:27017/ipl_manager"

# Host Authentication JWT Secret (min 16 chars)
JWT_SECRET="ipl-auction-secret-key-production-32-chars-long"

# Host Admin Login Password
HOST_ADMIN_PASS="ipl_host_admin_2026"

# Host Email OTP Service (Nodemailer Gmail SMTP)
SMTP_EMAIL="your_email@gmail.com"
SMTP_APP_PASSWORD="your_16_digit_app_password"

# Next.js Public WebSocket Server URL
NEXT_PUBLIC_WS_URL="http://localhost:3000"

# Developer Fast Clock toggle for instant timers in development (true/false)
DEV_FAST_CLOCK="false"
